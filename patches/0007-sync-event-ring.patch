+/*
+ * A ring of the last synchronisation events (futex waits and wakes, condition-variable waits and signals), kept only when a diagnostic asked for it
+ * (tl_sync_enable) and said on request (tl_sync_dump): when a game stops, the last few hundred of them show who was waiting on what, and who tried to wake it.
+ */
+typedef struct { uint64_t ns; const void *addr; const char *kind; long a, b; char who[20]; } sync_ev;
+#define SYNC_RING 1024
+static sync_ev g_sync[SYNC_RING];
+static atomic_ulong g_sync_n;
+static atomic_bool g_sync_on;
+void tl_sync_enable(bool on) { atomic_store(&g_sync_on, on); }
+void tl_sync_note(const char *kind, const void *addr, long a, long b)
+{
+    if (!atomic_load_explicit(&g_sync_on, memory_order_relaxed)) return;
+    sync_ev *e = &g_sync[atomic_fetch_add(&g_sync_n, 1) % SYNC_RING];
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    e->ns = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+    e->addr = addr; e->kind = kind; e->a = a; e->b = b;
+    e->who[0] = 0;
+    pthread_getname_np(pthread_self(), e->who, sizeof(e->who));
+}
+void tl_sync_dump(int n)
+{
+    unsigned long total = atomic_load(&g_sync_n);
+    if (n > SYNC_RING) n = SYNC_RING;
+    if ((unsigned long)n > total) n = (int)total;
+    uint64_t last = total ? g_sync[(total - 1) % SYNC_RING].ns : 0;
+    tl_log_line("sync: the last %d of %lu events (times are ms before the newest):", n, total);
+    for (unsigned long i = total - (unsigned long)n; i < total; i++) {
+        const sync_ev *e = &g_sync[i % SYNC_RING];
+        tl_log_line("sync: -%.1f %-22s %-14s %p %ld %ld", (double)(last - e->ns) / 1e6, e->who[0] ? e->who : "?", e->kind ? e->kind : "?", e->addr, e->a, e->b);
+    }
+}
