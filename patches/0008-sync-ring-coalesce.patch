diff --git a/src/translation-layer-next/husk-tl-bionic-io.c b/src/translation-layer-next/husk-tl-bionic-io.c
index 47a3193..03918f6 100644
--- a/src/translation-layer-next/husk-tl-bionic-io.c
+++ b/src/translation-layer-next/husk-tl-bionic-io.c
@@ -1415,7 +1415,7 @@ static int g_futex_trace = -1;
  * (tl_sync_enable) and said on request (tl_sync_dump): when a game stops, the last few hundred of them show who was waiting on what, and who tried to wake it.
  */
 typedef struct { uint64_t ns; const void *addr; const char *kind; long a, b; char who[20]; } sync_ev;
-#define SYNC_RING 1024
+#define SYNC_RING 4096
 static sync_ev g_sync[SYNC_RING];
 static atomic_ulong g_sync_n;
 static atomic_bool g_sync_on;
@@ -1433,14 +1433,42 @@ void tl_sync_note(const char *kind, const void *addr, long a, long b)
 void tl_sync_dump(int n)
 {
     unsigned long total = atomic_load(&g_sync_n);
-    if (n > SYNC_RING) n = SYNC_RING;
-    if ((unsigned long)n > total) n = (int)total;
-    uint64_t last = total ? g_sync[(total - 1) % SYNC_RING].ns : 0;
-    tl_log_line("sync: the last %d of %lu events (times are ms before the newest):", n, total);
-    for (unsigned long i = total - (unsigned long)n; i < total; i++) {
-        const sync_ev *e = &g_sync[i % SYNC_RING];
+    unsigned long have = total < SYNC_RING ? total : SYNC_RING;
+    if (!have) { tl_log_line("sync: no events"); return; }
+    unsigned long first = total - have;
+    uint64_t last = g_sync[(total - 1) % SYNC_RING].ns;
+    /* A thread that does the same thing over and over (a vsync thread broadcasting sixty times a second) would bury the rest: such a repeat is
+     * counted, and said once at the end; the other events are listed in order. */
+    static unsigned short rep[SYNC_RING];
+    for (unsigned long i = 0; i < have; i++) {
+        const sync_ev *a = &g_sync[(first + i) % SYNC_RING];
+        unsigned c = 0;
+        for (unsigned long k = 0; k < have; k++) {
+            const sync_ev *b = &g_sync[(first + k) % SYNC_RING];
+            if (a->addr == b->addr && a->kind == b->kind && !strcmp(a->who, b->who)) c++;
+        }
+        rep[i] = (unsigned short)(c > 60000 ? 60000 : c);
+    }
+    unsigned long quiet = 0;
+    for (unsigned long i = 0; i < have; i++) if (rep[i] <= 20) quiet++;
+    unsigned long skip = quiet > (unsigned long)n ? quiet - (unsigned long)n : 0;
+    tl_log_line("sync: %lu events kept of %lu; the last %lu that are not repeats (times are ms before the newest):", have, total, quiet - skip);
+    for (unsigned long i = 0; i < have; i++) {
+        if (rep[i] > 20) continue;
+        if (skip) { skip--; continue; }
+        const sync_ev *e = &g_sync[(first + i) % SYNC_RING];
         tl_log_line("sync: -%.1f %-22s %-14s %p %ld %ld", (double)(last - e->ns) / 1e6, e->who[0] ? e->who : "?", e->kind ? e->kind : "?", e->addr, e->a, e->b);
     }
+    for (unsigned long i = 0; i < have; i++) {
+        if (rep[i] <= 20) continue;
+        const sync_ev *e = &g_sync[(first + i) % SYNC_RING];
+        bool seen = false;
+        for (unsigned long k = 0; k < i && !seen; k++) { const sync_ev *b = &g_sync[(first + k) % SYNC_RING]; seen = e->addr == b->addr && e->kind == b->kind && !strcmp(e->who, b->who); }
+        if (seen) continue;
+        const sync_ev *lastrep = e;
+        for (unsigned long k = i; k < have; k++) { const sync_ev *b = &g_sync[(first + k) % SYNC_RING]; if (e->addr == b->addr && e->kind == b->kind && !strcmp(e->who, b->who)) lastrep = b; }
+        tl_log_line("sync: repeated %u times from -%.1f to -%.1f: %-22s %-14s %p", rep[i], (double)(last - e->ns) / 1e6, (double)(last - lastrep->ns) / 1e6, e->who[0] ? e->who : "?", e->kind ? e->kind : "?", e->addr);
+    }
 }
 
