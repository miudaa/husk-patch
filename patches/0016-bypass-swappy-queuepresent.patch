+/* Swappy (the frame pacer built into Unity 2020's libunity) stops the engine thread for good in SwappyVk_queuePresent: it waits on a result that a pool
+ * thread never delivers, after three frames. Presenting straight to Vulkan costs only the pacing (the display link paces it already). Only a build whose
+ * first instructions are the ones this was written for is touched; TL_SWAPPY_KEEP leaves it alone. */
+int tl_vk_present_direct(void *queue, const void *info);
+static void unity_bypass_swappy(void)
+{
+    if (getenv("TL_SWAPPY_KEEP")) return;
+    tl_lib *L = tl_ld_find_lib("libunity.so");
+    static const uint32_t expect[4] = { 0xf81e0ff4u, 0xa9017bf3u, 0xaa0103f3u, 0xf0002d81u };   /* SwappyVk_queuePresent of Unity 2020.3.33 */
+    uint64_t to = (uint64_t)(uintptr_t)tl_vk_present_direct;
+    uint32_t words[4] = { 0x58000050u, 0xd61f0200u, (uint32_t)to, (uint32_t)(to >> 32) };      /* ldr x16, #8 ; br x16 ; .quad target */
+    bool done = tl_ld_patch_code(L, 0xe0d7c8, expect, words, 4);
+    tl_log_line("unity: SwappyVk_queuePresent %s", done ? "now presents directly" : L ? "left as it is (not the build this knows)" : "not found (libunity.so is not loaded)");
+}
