@@ -455,6 +455,18 @@ void *tl_ld_sym_deep(tl_lib *lib, const char *name, tl_lib **found_in)
     return NULL;
 }
 
+/* Overwrite n instructions of a library's code, only if they are what the caller expects (a build it knows). */
+bool tl_ld_patch_code(tl_lib *L, uint64_t vaddr, const uint32_t *expect, const uint32_t *words, int n)
+{
+    if (!L || vaddr < L->base_vaddr) return false;
+    uint32_t *rw = (uint32_t *)(L->rw + (vaddr - L->base_vaddr));
+    const uint8_t *rx = L->rx + (vaddr - L->base_vaddr);
+    for (int i = 0; i < n; i++) if (rw[i] != expect[i]) return false;
+    for (int i = 0; i < n; i++) rw[i] = words[i];
+    tl_xmem_flush(rx, (size_t)n * 4);
+    return true;
+}
+
 /* Where the library's vaddr 0 lies in the executable view: what dladdr calls its base. */
 void *tl_ld_lib_base(const tl_lib *L) { return L ? (void *)(L->rx - L->base_vaddr) : NULL; }
 
