+/* A frozen engine: its thread is sent SIGUSR2 and says where it is -- the program counter, the link register and the frame-pointer chain, as library + offset
+ * for guest code (the offset is the address in the library's own file, so it can be looked up in the unpacked .so) and as a symbol for the host's. */
+static void stall_log_addr(int i, uintptr_t a)
+{
+    tl_lib *L = tl_ld_lib_of((const void *)a);
+    if (L) { tl_log_line("unity: stall: #%d %s +%#lx", i, tl_ld_lib_name(L), (unsigned long)(a - (uintptr_t)tl_ld_lib_base(L))); return; }
+    Dl_info di;
+    if (dladdr((const void *)a, &di) && di.dli_sname) tl_log_line("unity: stall: #%d host %s +%#lx", i, di.dli_sname, (unsigned long)(a - (uintptr_t)di.dli_saddr));
+    else tl_log_line("unity: stall: #%d %#lx", i, (unsigned long)a);
+}
+static void stall_dump_handler(int sig, siginfo_t *si, void *ctx)
+{
+    (void)sig; (void)si;
+#if defined(__aarch64__) && TARGET_OS_IPHONE
+    ucontext_t *uc = (ucontext_t *)ctx;
+    uintptr_t pc = (uintptr_t)__darwin_arm_thread_state64_get_pc(uc->uc_mcontext->__ss);
+    uintptr_t lr = (uintptr_t)__darwin_arm_thread_state64_get_lr(uc->uc_mcontext->__ss);
+    uintptr_t fp = (uintptr_t)__darwin_arm_thread_state64_get_fp(uc->uc_mcontext->__ss);
+    tl_log_line("unity: stall: the engine thread is at:");
+    stall_log_addr(0, pc);
+    stall_log_addr(1, lr);
+    uintptr_t prev = 0;
+    for (int i = 2; i < 26 && fp && !(fp & 7) && fp > 0x100000 && fp > prev && (!prev || fp - prev < (1u << 20)); i++) {
+        uintptr_t ret = ((uintptr_t *)fp)[1];
+        if (!ret) break;
+        stall_log_addr(i, ret);
+        prev = fp;
+        fp = ((uintptr_t *)fp)[0];
+    }
+#else
+    (void)ctx;
+#endif
+}
+
