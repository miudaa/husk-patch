-#define PASS_BOOL(name, params, args) static EGLBoolean w_##name params { return a_##name args; }
+/* A call that fails is always said (with eglGetError); under TL_EGL_TRACE every call is, so a run that stops before it draws shows which
+ * EGL step the engine gave up on. */
+static void egl_note_bool(const char *name, EGLBoolean ok)
+{
+    static int trace = -1;
+    if (trace < 0) trace = getenv("TL_EGL_TRACE") ? 1 : 0;
+    if (trace || !ok) tl_log_line("egl: %s -> %s%s%#x", name, ok ? "true" : "false", ok ? "" : ", eglGetError ", ok ? 0 : (E.ready ? a_eglGetError() : 0x3001));
+}
+#define PASS_BOOL(name, params, args) static EGLBoolean w_##name params { EGLBoolean ok = a_##name args; egl_note_bool(#name, ok); return ok; }
