diff --git a/src/translation-layer-next/husk-tl-unity.c b/src/translation-layer-next/husk-tl-unity.c
index eb4b1d8..6babcb9 100644
--- a/src/translation-layer-next/husk-tl-unity.c
+++ b/src/translation-layer-next/husk-tl-unity.c
@@ -279,6 +279,16 @@ static void pad_key(jobj *ev, int device, int action, int keycode, int64_t down_
 static void pad_motion(jobj *ev, int device, int source, int64_t down_ms, int64_t event_ms)
 { (void)device; (void)source; (void)down_ms; (void)event_ms; inject(ev); }
 
+extern jobj *tl_input_key_event(int action, int keycode, int device, int source, int repeat, int64_t down_ms, int64_t event_ms);
+/* The Back key (KEYCODE_BACK): a game maps it to Escape. There is no key on an iPhone to send it, so the app draws a button. */
+void tl_unity_back(void)
+{
+    int64_t now = uptime_ms();
+    inject(tl_input_key_event(0 /* ACTION_DOWN */, 4 /* KEYCODE_BACK */, 0, 0x101 /* SOURCE_KEYBOARD */, 0, now, now));
+    usleep(50000);
+    inject(tl_input_key_event(1 /* ACTION_UP */, 4, 0, 0x101, 0, now, now + 50));
+}
+
 void tl_unity_register_pad_sink(void)
 {
     static const tl_pad_sink sink = { pad_key, pad_motion };
