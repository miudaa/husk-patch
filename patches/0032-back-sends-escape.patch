diff --git a/src/translation-layer-next/husk-tl-unity.c b/src/translation-layer-next/husk-tl-unity.c
index ad8f6fb..22e63a8 100644
--- a/src/translation-layer-next/husk-tl-unity.c
+++ b/src/translation-layer-next/husk-tl-unity.c
@@ -288,9 +288,12 @@ void tl_unity_back(void)
     tl_log_line("unity: Back pressed (#%d)", presses);
     if (trace) tl_jni_set_trace(2);                  /* what the engine asks of the key event, and what it is told */
     int64_t now = uptime_ms();
-    inject(tl_input_key_event(0 /* ACTION_DOWN */, 4 /* KEYCODE_BACK */, 0, 0x101 /* SOURCE_KEYBOARD */, 0, now, now));
+    /* KEYCODE_BACK (4) is read and dropped by the engine (the log shows getAction and getKeyCode and nothing after); KEYCODE_ESCAPE (111) is what Back
+     * becomes in a game anyway (KeyCode.Escape). */
+    const int key = getenv("TL_BACK_KEYCODE") ? atoi(getenv("TL_BACK_KEYCODE")) : 111;
+    inject(tl_input_key_event(0 /* ACTION_DOWN */, key, 0, 0x101 /* SOURCE_KEYBOARD */, 0, now, now));
     usleep(50000);
-    inject(tl_input_key_event(1 /* ACTION_UP */, 4, 0, 0x101, 0, now, now + 50));
+    inject(tl_input_key_event(1 /* ACTION_UP */, key, 0, 0x101, 0, now, now + 50));
     if (trace) tl_jni_set_trace(0);
 }
 
