index 165ffc2..050b6e8 100644
--- a/src/translation-layer-next/husk-tl-bionic-pthread.c
+++ b/src/translation-layer-next/husk-tl-bionic-pthread.c
@@ -427,6 +427,32 @@ void tl_thread_altstack(void)
     stack_t ss = { .ss_sp = malloc(64 << 10), .ss_size = 64 << 10, .ss_flags = 0 };
     if (ss.ss_sp) sigaltstack(&ss, NULL);
 }
+/* The threads the game started and that are still running, so a diagnostic can signal them all (tl_guest_threads_signal). */
+#define GT_MAX 256
+static struct { pthread_t t; bool used; } g_gt[GT_MAX];
+static pthread_mutex_t g_gt_mu = PTHREAD_MUTEX_INITIALIZER;
+static int gt_add(void)
+{
+    int slot = -1;
+    pthread_mutex_lock(&g_gt_mu);
+    for (int i = 0; i < GT_MAX; i++) if (!g_gt[i].used) { g_gt[i].used = true; g_gt[i].t = pthread_self(); slot = i; break; }
+    pthread_mutex_unlock(&g_gt_mu);
+    return slot;
+}
+static void gt_del(int slot)
+{
+    if (slot < 0) return;
+    pthread_mutex_lock(&g_gt_mu);
+    g_gt[slot].used = false;
+    pthread_mutex_unlock(&g_gt_mu);
+}
+void tl_guest_threads_signal(int darwin_sig);
+void tl_guest_threads_signal(int darwin_sig)
+{
+    pthread_mutex_lock(&g_gt_mu);
+    for (int i = 0; i < GT_MAX; i++) if (g_gt[i].used && !pthread_equal(g_gt[i].t, pthread_self())) pthread_kill(g_gt[i].t, darwin_sig);
+    pthread_mutex_unlock(&g_gt_mu);
+}
 static void *start_thunk(void *p)
 {
     start_ctx c = *(start_ctx *)p;
@@ -440,7 +466,9 @@ static void *start_thunk(void *p)
         const char *sym = tl_ld_symbol_at((const void *)c.fn, &ln, &sa);
         tl_log_line("thread: started, entry %s %s+%#lx", ln ? ln : "?", sym ? sym : "?", sa ? (unsigned long)((const char *)c.fn - (const char *)sa) : 0ul);
     }
+    int slot = gt_add();
     void *r = c.fn(c.arg);
+    gt_del(slot);
     if (g_thread_trace) { char nm[32] = ""; pthread_getname_np(pthread_self(), nm, sizeof(nm)); tl_log_line("thread: '%s' EXITED", nm); }
     return r;
 }
