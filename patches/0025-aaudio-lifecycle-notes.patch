+            if (o->diag_buffers % 200 == 0) {
+                struct timespec now; clock_gettime(CLOCK_MONOTONIC, &now);
+                double ms = (double)(now.tv_sec - o->diag_t.tv_sec) * 1e3 + (double)(now.tv_nsec - o->diag_t.tv_nsec) / 1e6;
+                tl_log_line("opensl: player %p: %d buffers (200 took %.0f ms), loudest so far %d", (void *)o, o->diag_buffers, o->diag_t.tv_sec ? ms : 0.0, o->diag_peak);
+                o->diag_t = now; o->diag_peak = 0;
+            }
         }
         if (tl_cocos_audio_hook) tl_cocos_audio_hook((const int16_t *)data, frames, ch, rate);
         else { struct timespec ts = { 0, (long)((double)frames * 1e9 / rate) }; nanosleep(&ts, NULL); }
