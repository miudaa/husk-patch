diff --git a/src/translation-layer-next/husk-tl-unity.c b/src/translation-layer-next/husk-tl-unity.c
index faacf76..332d3b4 100644
--- a/src/translation-layer-next/husk-tl-unity.c
+++ b/src/translation-layer-next/husk-tl-unity.c
@@ -23,6 +23,8 @@ void tl_hle_configure(const char *pkg, const char *apk, const char *data, int w,
 jobj *tl_hle_activity(void);
 void tl_set_data_dir(const char *dir);
 void tl_nwindow_configure(int w, int h, void *layer);
+int tl_manifest_gles(const char *apk);
+void tl_egl_es3_claim(int minor);
 
 static struct {
     tl_unity_config cfg;
@@ -61,6 +63,20 @@ bool tl_unity_start(const tl_unity_config *cfg)
     int n = tl_dexidx_open(cfg->apk_path);
     tl_log_line("unity: %d classes in the APK's DEX", n);
     if (!tl_ld_add_apk(cfg->apk_path)) return false;
+    /* A Unity build with "Require ES3.1" (or 3.2) in its player settings writes that into the manifest, and its engine refuses a
+     * device whose driver is older with "Your device does not match the hardware requirements of this application" -- and then
+     * never draws a frame. ANGLE over Metal stops at ES 3.0, so such a game is told the driver has what it asks for, as the Java
+     * runtime and the Unreal and Minecraft drivers already do. */
+    {
+        int gv = tl_manifest_gles(cfg->apk_path);
+        tl_log_line("unity: the manifest asks for OpenGL ES %d.%d", gv >> 16, gv & 0xffff);
+        if (gv >= 0x30001) {
+            tl_egl_es3_claim(gv & 0xffff);
+            tl_log_line("egl: the manifest asks for OpenGL ES 3.%d: the driver is described so", gv & 0xffff);
+        }
+        /* Say what the engine asks of EGL (configs, contexts, current surfaces): a run that still draws nothing then shows why. */
+        setenv("TL_EGL_TRACE", "1", 0);
+    }
     if (cfg->angle_egl && !tl_egl_init(cfg->angle_egl, cfg->angle_gles, cfg->frame_dir, cfg->frame_every)) return false;
     tl_jni_init();
     tl_hle_configure(cfg->package_name, cfg->apk_path, cfg->data_dir, cfg->width, cfg->height);
